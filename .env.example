# Copy to `.env` at the repo root. `.env` is gitignored — never commit real values.
# Root-level scripts (`pnpm dev`, `pnpm build`, `pnpm db:*`) load this file via dotenv-cli.

# Postgres (Neon). Two URLs on purpose:
#   DATABASE_URL        direct connection — drizzle-kit generate/migrate only.
#   DATABASE_URL_POOLED pooled connection — everything the app does at runtime.
# Serverless opens a connection per invocation, so runtime never uses the direct URL.
DATABASE_URL=postgresql://user:password@host.neon.tech/degencage?sslmode=require
DATABASE_URL_POOLED=postgresql://user:password@host-pooler.neon.tech/degencage?sslmode=require

# Error tracking. Unset = Sentry no-ops; the wrapper still logs.
SENTRY_DSN=

# Log level for the pino wrapper: trace|debug|info|warn|error|fatal.
LOG_LEVEL=info
